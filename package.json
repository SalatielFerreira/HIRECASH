{
  "name": "hirecash",
  "version": "0.14.0",
  "private": true,
  "description": "HireCash — PWA para gestão de candidatos, dashboard e comissões.",
  "author": "Salatiel Ferreira",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "live-server docs --port=5500 --quiet --no-browser",
    "lint": "eslint docs/scripts",
    "lint:css": "stylelint \"docs/styles/**/*.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "live-server": "^1.2.2",
    "sharp": "^0.33.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
